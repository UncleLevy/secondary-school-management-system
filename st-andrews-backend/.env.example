SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Resend (https://resend.com) — used to email guardians from the Communications app
RESEND_API_KEY=
EMAIL_FROM=no-reply@school.local

# Twilio (https://www.twilio.com) — used to send SMS to teachers and guardians.
# Provide either a sender number or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Local numbers starting with 0 are converted with this country code (260 = Zambia)
SMS_DEFAULT_COUNTRY_CODE=260
