SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# SMS provider used to text teachers: africastalking (default) or twilio
SMS_PROVIDER=africastalking
# If sending fails, retry through the other provider when its keys are set (true/false)
SMS_FALLBACK=true

# Africa's Talking (https://africastalking.com)
# AT_USERNAME is your app username from the dashboard ("sandbox" for the test sandbox).
# AT_SENDER_ID is optional; leave blank to use the shared sender.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Twilio (https://www.twilio.com) — used when SMS_PROVIDER=twilio, or as the fallback.
# Provide either a sender number or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Local numbers starting with 0 are converted with this country code (260 = Zambia)
SMS_DEFAULT_COUNTRY_CODE=260


# Email — Gmail with an App Password.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put the Gmail address and the 16-character App Password below, then restart the server.
# (Your normal Gmail password will NOT work.) Leave both blank to only print emails in the
# terminal for testing.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: shown as the sender name, e.g. School Timetable <you@gmail.com>
DEFAULT_FROM_EMAIL=
SCHOOL_NAME=School Timetable

# One-time passcodes emailed to users. Set OTP_LOGIN_REQUIRED=true to ask for a code
# after the password at every sign-in (users without an email address skip it).
# Forgot-password codes always work.
OTP_LOGIN_REQUIRED=false
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
